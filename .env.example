# Content of the Firebase service account JSON file, on a single line, in single quotes
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key_id":"your-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"000000000000000000000","token_uri":"https://oauth2.googleapis.com/token"}'

# Address the app is served from, with the trailing slash
URL=http://localhost:3000/

# "development" disables the HTTPS redirect and the rate limit
NODE_ENV=development

PORT=3000
